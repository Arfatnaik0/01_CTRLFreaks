                className="p-2 hover:bg-gray-700 rounded-lg transition-colors"
              >
                <span className="text-gray-400 text-xl">×</span>
              </button>
            </div>

            {/* Modal Content */}
            <div className="p-6 space-y-6">
              {/* Device Information */}
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                {/* Basic Info */}
                <div className="bg-gray-700/50 border border-gray-600 rounded-lg p-4">
                  <h3 className="text-lg font-semibold text-white mb-4">Device Information</h3>
                  <div className="space-y-3">
                    <div className="flex justify-between">
                      <span className="text-gray-400">Device ID:</span>
                      <span className="text-white font-medium">{selectedDevice.device_id}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-gray-400">Type:</span>
                      <span className="text-white capitalize">{selectedDevice.device_type || 'IoT Device'}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-gray-400">Location:</span>
                      <span className="text-white">{selectedDevice.location || 'Industrial Facility'}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-gray-400">Manufacturer:</span>
                      <span className="text-white">{selectedDevice.manufacturer || 'Industrial Corp'}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-gray-400">Model:</span>
                      <span className="text-white">{selectedDevice.model || 'IND-2024-PRO'}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-gray-400">Status:</span>
                      <span className={`capitalize font-medium ${
                        selectedDevice.status === 'active' ? 'text-green-400' :
                        selectedDevice.status === 'maintenance' ? 'text-yellow-400' :
                        'text-red-400'
                      }`}>
                        {selectedDevice.status || 'active'}
                      </span>
                    </div>
                  </div>
                </div>

                {/* Current Readings */}
                <div className="bg-gray-700/50 border border-gray-600 rounded-lg p-4">
                  <h3 className="text-lg font-semibold text-white mb-4">Current Readings</h3>
                  {selectedDevice.lastReading ? (
                    <div className="space-y-3">
                      <div className="flex justify-between">
                        <span className="text-gray-400">Temperature:</span>
                        <span className="text-white font-medium">{selectedDevice.lastReading.temperature}°C</span>
                      </div>
                      <div className="flex justify-between">
                        <span className="text-gray-400">Current:</span>
                        <span className="text-white font-medium">{selectedDevice.lastReading.current_value}A</span>
                      </div>
                      <div className="flex justify-between">
                        <span className="text-gray-400">Pressure:</span>
                        <span className="text-white font-medium">{selectedDevice.lastReading.pressure} bar</span>
                      </div>
                      <div className="flex justify-between">
                        <span className="text-gray-400">Power:</span>
                        <span className="text-white font-medium">{selectedDevice.lastReading.energy_consumption} kW</span>
                      </div>
                      <div className="flex justify-between">
                        <span className="text-gray-400">Last Update:</span>
                        <span className="text-white font-medium">
                          {new Date(selectedDevice.lastReading.timestamp).toLocaleTimeString()}
                        </span>
                      </div>
                    </div>
                  ) : (
                    <div className="text-center py-4">
                      <span className="text-gray-400">No recent readings available</span>
                    </div>
                  )}
                </div>
              </div>

              {/* Specifications */}
              <div className="bg-gray-700/50 border border-gray-600 rounded-lg p-4">
                <h3 className="text-lg font-semibold text-white mb-4">Technical Specifications</h3>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div className="text-center">
                    <div className="text-2xl font-bold text-blue-400 mb-1">
                      {selectedDevice.max_current || '25.0'}A
                    </div>
                    <div className="text-sm text-gray-400">Max Current</div>
                  </div>
                  <div className="text-center">
                    <div className="text-2xl font-bold text-red-400 mb-1">
                      {selectedDevice.max_temperature || '150'}°C
                    </div>
                    <div className="text-sm text-gray-400">Max Temperature</div>
                  </div>
                  <div className="text-center">
                    <div className="text-2xl font-bold text-green-400 mb-1">
                      {selectedDevice.max_pressure || '15.0'} bar
                    </div>
                    <div className="text-sm text-gray-400">Max Pressure</div>
                  </div>
                </div>
              </div>

              {/* Recent Sensor History */}
              <div className="bg-gray-700/50 border border-gray-600 rounded-lg p-4">
                <h3 className="text-lg font-semibold text-white mb-4">Recent Sensor History</h3>
                {selectedDevice.sensorData && selectedDevice.sensorData.length > 0 ? (
                  <div className="overflow-x-auto">
                    <table className="w-full text-sm">
                      <thead>
                        <tr className="border-b border-gray-600">
                          <th className="text-left text-gray-400 py-2">Time</th>
                          <th className="text-left text-gray-400 py-2">Temp (°C)</th>
                          <th className="text-left text-gray-400 py-2">Current (A)</th>
                          <th className="text-left text-gray-400 py-2">Pressure (bar)</th>
                          <th className="text-left text-gray-400 py-2">Power (kW)</th>
                        </tr>
                      </thead>
                      <tbody>
                        {selectedDevice.sensorData.slice(0, 5).map((reading, index) => (
                          <tr key={index} className="border-b border-gray-700/50">
                            <td className="py-2 text-white">
                              {new Date(reading.timestamp).toLocaleTimeString()}
                            </td>
                            <td className="py-2 text-white">{reading.temperature}</td>
                            <td className="py-2 text-white">{reading.current_value}</td>
                            <td className="py-2 text-white">{reading.pressure}</td>
                            <td className="py-2 text-white">{reading.energy_consumption}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ) : (
                  <div className="text-center py-8">
                    <div className="text-4xl mb-2">📊</div>
                    <p className="text-gray-400">No sensor history available</p>
                  </div>
                )}
              </div>

              {/* Action Buttons */}
              <div className="flex justify-end space-x-3">
                <button className="px-4 py-2 bg-blue-500/20 text-blue-400 border border-blue-500/30 rounded-lg hover:bg-blue-500/30 transition-colors">
                  Download Report
                </button>
                <button className="px-4 py-2 bg-yellow-500/20 text-yellow-400 border border-yellow-500/30 rounded-lg hover:bg-yellow-500/30 transition-colors">
                  Schedule Maintenance
                </button>
                <button className="px-4 py-2 bg-gray-500/20 text-gray-400 border border-gray-500/30 rounded-lg hover:bg-gray-500/30 transition-colors">
                  Control Settings
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* ML Insights Modal */}
      {showMLModal && (
        <div className="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
          <div className="bg-gray-800 border border-gray-700 rounded-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
            {/* Modal Header */}
            <div className="flex items-center justify-between p-6 border-b border-gray-700">
              <div className="flex items-center space-x-4">
                <div className={`p-3 rounded-lg ${
                  mlModalType === 'anomalies' ? 'bg-red-500/20' :
                  mlModalType === 'maintenance' ? 'bg-orange-500/20' :
                  'bg-emerald-500/20'
                }`}>
                  <span className="text-2xl">
                    {mlModalType === 'anomalies' ? '🤖' :
                     mlModalType === 'maintenance' ? '🔧' : '📊'}
                  </span>
                </div>
                <div>
                  <h2 className="text-2xl font-bold text-white">
                    {mlModalType === 'anomalies' ? 'AI Anomaly Detection' :
                     mlModalType === 'maintenance' ? 'Predictive Maintenance' :
                     'System Efficiency Analysis'}
                  </h2>
                  <p className="text-gray-400">
                    {mlModalType === 'anomalies' ? 'Machine learning powered anomaly detection' :
                     mlModalType === 'maintenance' ? 'Predictive maintenance scheduling' :
                     'AI-optimized efficiency monitoring'}
                  </p>
                </div>
              </div>
              <button
                onClick={() => setShowMLModal(false)}
                className="p-2 hover:bg-gray-700 rounded-lg transition-colors"
              >
                <span className="text-gray-400 text-xl">×</span>
              </button>
            </div>

            {/* Modal Content */}
            <div className="p-6 space-y-6">
              {mlModalType === 'anomalies' && (
                <>
                  {/* Anomaly Summary */}
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div className="bg-red-600/20 border border-red-500/30 rounded-lg p-4 text-center">
                      <div className="text-2xl font-bold text-white mb-1">{mlInsights.anomalies}</div>
                      <div className="text-sm text-red-300">Total Anomalies</div>
                    </div>
                    <div className="bg-gray-600/20 border border-gray-500/30 rounded-lg p-4 text-center">
                      <div className="text-2xl font-bold text-white mb-1">94.2%</div>
                      <div className="text-sm text-gray-300">Model Accuracy</div>
                    </div>
                    <div className="bg-blue-600/20 border border-blue-500/30 rounded-lg p-4 text-center">
                      <div className="text-2xl font-bold text-white mb-1">Isolation Forest</div>
                      <div className="text-sm text-blue-300">ML Algorithm</div>
                    </div>
                  </div>

                  {/* Detected Anomalies */}
                  <div className="bg-gray-700/50 border border-gray-600 rounded-lg p-6">
                    <h3 className="text-lg font-semibold text-white mb-4">Detected Anomalies</h3>
                    <div className="space-y-4">
                      <div className="bg-red-600/10 border border-red-500/30 rounded-lg p-4">
                        <div className="flex items-center justify-between mb-2">
                          <h4 className="font-medium text-white">BOILER_001 - Temperature Spike</h4>
                          <span className="text-xs px-2 py-1 rounded-full bg-red-500/20 text-red-400">HIGH RISK</span>
                        </div>
                        <p className="text-sm text-gray-300 mb-2">Temperature reading 15% above normal baseline (135.9°C vs 118°C avg)</p>
                        <div className="flex justify-between text-xs text-gray-400">
                          <span>Anomaly Score: -0.0592</span>
                          <span>Confidence: 89%</span>
                          <span>3 minutes ago</span>
                        </div>
                      </div>
                      
                      <div className="bg-yellow-600/10 border border-yellow-500/30 rounded-lg p-4">
                        <div className="flex items-center justify-between mb-2">
                          <h4 className="font-medium text-white">MOTOR_003 - Power Fluctuation</h4>
                          <span className="text-xs px-2 py-1 rounded-full bg-yellow-500/20 text-yellow-400">MEDIUM RISK</span>
                        </div>
                        <p className="text-sm text-gray-300 mb-2">Unusual power consumption pattern detected (4.2kW with high variance)</p>
                        <div className="flex justify-between text-xs text-gray-400">
                          <span>Anomaly Score: -0.0431</span>
                          <span>Confidence: 76%</span>
                          <span>8 minutes ago</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </>
              )}

              {mlModalType === 'maintenance' && (
                <>
                  {/* Maintenance Summary */}
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div className="bg-orange-600/20 border border-orange-500/30 rounded-lg p-4 text-center">
                      <div className="text-2xl font-bold text-white mb-1">{mlInsights.maintenance}</div>
                      <div className="text-sm text-orange-300">Maintenance Due</div>
                    </div>
                    <div className="bg-gray-600/20 border border-gray-500/30 rounded-lg p-4 text-center">
                      <div className="text-2xl font-bold text-white mb-1">91.7%</div>
                      <div className="text-sm text-gray-300">Prediction Accuracy</div>
                    </div>
                    <div className="bg-blue-600/20 border border-blue-500/30 rounded-lg p-4 text-center">
                      <div className="text-2xl font-bold text-white mb-1">Random Forest</div>
                      <div className="text-sm text-blue-300">ML Algorithm</div>
                    </div>
                  </div>

                  {/* Maintenance Schedule */}
                  <div className="bg-gray-700/50 border border-gray-600 rounded-lg p-6">
                    <h3 className="text-lg font-semibold text-white mb-4">Predicted Maintenance Schedule</h3>
                    <div className="space-y-4">
                      <div className="bg-red-600/10 border border-red-500/30 rounded-lg p-4">
                        <div className="flex items-center justify-between mb-2">
                          <h4 className="font-medium text-white">SENSOR_004 - Battery Replacement</h4>
                          <span className="text-xs px-2 py-1 rounded-full bg-red-500/20 text-red-400">7 DAYS</span>
                        </div>
                        <p className="text-sm text-gray-300 mb-2">Battery level declining, signal strength issues detected</p>
                        <div className="flex justify-between text-xs text-gray-400">
                          <span>Risk Score: 88%</span>
                          <span>Confidence: 91%</span>
                          <span>Priority: High</span>
                        </div>
                      </div>
                      
                      <div className="bg-yellow-600/10 border border-yellow-500/30 rounded-lg p-4">
                        <div className="flex items-center justify-between mb-2">
                          <h4 className="font-medium text-white">GENERATOR_001 - Service Check</h4>
                          <span className="text-xs px-2 py-1 rounded-full bg-yellow-500/20 text-yellow-400">15 DAYS</span>
                        </div>
                        <p className="text-sm text-gray-300 mb-2">Fuel consumption increase, operating hours threshold approaching</p>
                        <div className="flex justify-between text-xs text-gray-400">
                          <span>Risk Score: 67%</span>
                          <span>Confidence: 90%</span>
                          <span>Priority: Medium</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </>
              )}

              {mlModalType === 'efficiency' && (
                <>
                  {/* Efficiency Summary */}
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div className="bg-emerald-600/20 border border-emerald-500/30 rounded-lg p-4 text-center">
                      <div className="text-2xl font-bold text-white mb-1">{mlInsights.efficiency}%</div>
                      <div className="text-sm text-emerald-300">Current Efficiency</div>
                    </div>
                    <div className="bg-green-600/20 border border-green-500/30 rounded-lg p-4 text-center">
                      <div className="text-2xl font-bold text-white mb-1">+2.3%</div>
                      <div className="text-sm text-green-300">This Week</div>
                    </div>
                    <div className="bg-blue-600/20 border border-blue-500/30 rounded-lg p-4 text-center">
                      <div className="text-2xl font-bold text-white mb-1">$2,400</div>
                      <div className="text-sm text-blue-300">Monthly Savings</div>
                    </div>
                  </div>

                  {/* Efficiency Analysis */}
                  <div className="bg-gray-700/50 border border-gray-600 rounded-lg p-6">
                    <h3 className="text-lg font-semibold text-white mb-4">AI Optimization Recommendations</h3>
                    <div className="space-y-4">
                      <div className="bg-green-600/10 border border-green-500/30 rounded-lg p-4">
                        <div className="flex items-center justify-between mb-2">
                          <h4 className="font-medium text-white">HVAC Schedule Optimization</h4>
                          <span className="text-xs px-2 py-1 rounded-full bg-green-500/20 text-green-400">12% SAVINGS</span>
                        </div>
                        <p className="text-sm text-gray-300 mb-2">Adjust HVAC_001 schedule to reduce power consumption during off-peak hours</p>
                        <div className="flex justify-between text-xs text-gray-400">
                          <span>Potential Savings: $2,400/month</span>
                          <span>Implementation: Easy</span>
                          <span>Confidence: 94%</span>
                        </div>
                      </div>
                      
                      <div className="bg-blue-600/10 border border-blue-500/30 rounded-lg p-4">
                        <div className="flex items-center justify-between mb-2">
                          <h4 className="font-medium text-white">Motor Load Balancing</h4>
                          <span className="text-xs px-2 py-1 rounded-full bg-blue-500/20 text-blue-400">8% SAVINGS</span>
                        </div>
                        <p className="text-sm text-gray-300 mb-2">Redistribute workload across motors to optimize energy consumption</p>
                        <div className="flex justify-between text-xs text-gray-400">
                          <span>Potential Savings: $1,600/month</span>
                          <span>Implementation: Medium</span>
                          <span>Confidence: 87%</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </>
              )}

              {/* Action Buttons */}
              <div className="flex justify-end space-x-3">
                <button className="px-4 py-2 bg-blue-500/20 text-blue-400 border border-blue-500/30 rounded-lg hover:bg-blue-500/30 transition-colors">
                  Export Report
                </button>
                <button className={`px-4 py-2 border rounded-lg transition-colors ${
                  mlModalType === 'anomalies' ? 'bg-red-500/20 text-red-400 border-red-500/30 hover:bg-red-500/30' :
                  mlModalType === 'maintenance' ? 'bg-orange-500/20 text-orange-400 border-orange-500/30 hover:bg-orange-500/30' :
                  'bg-emerald-500/20 text-emerald-400 border-emerald-500/30 hover:bg-emerald-500/30'
                }`}>
                  {mlModalType === 'anomalies' ? 'Create Alert' :
                   mlModalType === 'maintenance' ? 'Schedule Work' : 'Apply Optimizations'}
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

export default App;
