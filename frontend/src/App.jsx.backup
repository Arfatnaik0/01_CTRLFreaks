import React, { useState, useEffect } from 'react';
import './App.css';

// Import ML Analytics component
import MLAnalytics from './components/MLAnalytics';
import EnhancedSystemMetrics from './components/EnhancedSystemMetrics';
import MLEnhancedAlertPanel from './components/MLEnhancedAlertPanel';
import MLEnhancedDeviceGrid from './components/MLEnhancedDeviceGrid';

// Simple fallback components to avoid import errors
const SimpleDeviceGrid = ({ devices = [] }) => (
  <div className="bg-gray-800 rounded-lg p-6">
    <h3 className="text-lg font-semibold text-white mb-4">Devices ({devices.length})</h3>
    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {devices.slice(0, 6).map((device, index) => (
        <div key={index} className="bg-gray-700 rounded-lg p-4">
          <h4 className="font-medium text-white">{device.device_id || `Device ${index + 1}`}</h4>
          <p className="text-sm text-gray-400">{device.location || 'Unknown Location'}</p>
          <div className="mt-2">
            <span className="text-xs px-2 py-1 rounded-full bg-green-500/20 text-green-400">
              {device.status || 'active'}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
);

const SimpleAlertPanel = ({ alerts = [] }) => (
  <div className="bg-gray-800 rounded-lg p-6">
    <h3 className="text-lg font-semibold text-white mb-4">Recent Alerts ({alerts.length})</h3>
    <div className="space-y-3">
      {alerts.slice(0, 5).map((alert, index) => (
        <div key={index} className="border border-yellow-500/30 bg-yellow-500/10 rounded-lg p-3">
          <div className="flex items-start justify-between">
            <div>
              <h5 className="font-medium text-yellow-400">{alert.device_id || `Device Alert ${index + 1}`}</h5>
              <p className="text-sm text-yellow-300">{alert.message || 'System alert detected'}</p>
            </div>
            <span className="text-xs px-2 py-1 rounded-full bg-yellow-500/20 text-yellow-400">
              {alert.severity || 'warning'}
            </span>
          </div>
        </div>
      ))}
      {alerts.length === 0 && (
        <div className="text-center py-8">
          <p className="text-gray-400">No active alerts</p>
        </div>
      )}
    </div>
  </div>
);

const SimpleSystemMetrics = ({ stats = {} }) => (
  <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
    <div className="bg-gray-700 rounded-lg p-6">
      <div className="flex items-center justify-between mb-4">
        <div className="p-3 rounded-lg bg-blue-500/20 text-blue-400">
          <span className="text-2xl">🏭</span>
        </div>
      </div>
      <h4 className="text-2xl font-bold text-white mb-1">{stats.total_devices || 33}</h4>
      <p className="text-sm text-gray-400">Total Devices</p>
    </div>
    
    <div className="bg-gray-700 rounded-lg p-6">
      <div className="flex items-center justify-between mb-4">
        <div className="p-3 rounded-lg bg-green-500/20 text-green-400">
          <span className="text-2xl">✅</span>
        </div>
      </div>
      <h4 className="text-2xl font-bold text-white mb-1">{stats.active_devices || 31}</h4>
      <p className="text-sm text-gray-400">Active Devices</p>
    </div>
    
    <div className="bg-gray-700 rounded-lg p-6">
      <div className="flex items-center justify-between mb-4">
        <div className="p-3 rounded-lg bg-yellow-500/20 text-yellow-400">
          <span className="text-2xl">⚠️</span>
        </div>
      </div>
      <h4 className="text-2xl font-bold text-white mb-1">{stats.active_alerts || 0}</h4>
      <p className="text-sm text-gray-400">Active Alerts</p>
    </div>
    
    <div className="bg-gray-700 rounded-lg p-6">
      <div className="flex items-center justify-between mb-4">
        <div className="p-3 rounded-lg bg-purple-500/20 text-purple-400">
          <span className="text-2xl">⚡</span>
        </div>
      </div>
      <h4 className="text-2xl font-bold text-white mb-1">{stats.total_energy_consumption?.toFixed(1) || '59.3'} kWh</h4>
      <p className="text-sm text-gray-400">Energy Usage</p>
    </div>
  </div>
);

function App() {
  const [devices, setDevices] = useState([]);
  const [alerts, setAlerts] = useState([]);
  const [systemStats, setSystemStats] = useState({});
  const [loading, setLoading] = useState(true);
  const [activeTab, setActiveTab] = useState('overview');
  const [lastUpdate, setLastUpdate] = useState(new Date());
  const [error, setError] = useState(null);
  const [nextUpdate, setNextUpdate] = useState(60);
  const [selectedDevice, setSelectedDevice] = useState(null);
  const [showDeviceModal, setShowDeviceModal] = useState(false);
  const [mlInsights, setMlInsights] = useState({
    anomalies: 3,
    maintenance: 5,
    efficiency: 89.4,
    anomaliesList: [],
    maintenanceList: [],
    efficiencyTrend: 'up'
  });
  const [showMLModal, setShowMLModal] = useState(false);
  const [mlModalType, setMLModalType] = useState(null);

  // Fetch data from API
  const fetchData = async () => {
    setLoading(true);
    try {
      const API_BASE = 'http://localhost:5000/api';
      console.log('Fetching data from API...', new Date().toISOString());
      
      // Fetch devices
      const devicesRes = await fetch(`${API_BASE}/devices`);
      if (!devicesRes.ok) throw new Error(`Devices API error: ${devicesRes.status}`);
      const devicesData = await devicesRes.json();
      setDevices(Array.isArray(devicesData) ? devicesData : []);

      // Fetch alerts
      const alertsRes = await fetch(`${API_BASE}/alerts`);
      if (!alertsRes.ok) throw new Error(`Alerts API error: ${alertsRes.status}`);
      const alertsData = await alertsRes.json();
      setAlerts(Array.isArray(alertsData) ? alertsData : []);

      // Fetch system stats
      const statsRes = await fetch(`${API_BASE}/system-stats`);
      if (!statsRes.ok) throw new Error(`Stats API error: ${statsRes.status}`);
      const statsData = await statsRes.json();
      setSystemStats(statsData || {});

      setLastUpdate(new Date());
      setError(null);
      console.log('Data fetched successfully:', {
        devices: devicesData?.length || 0,
        alerts: alertsData?.length || 0,
        stats: statsData
      });
    } catch (error) {
      console.error('Error fetching data:', error);
      setError(error.message);
      // Set mock data on error
      setDevices([
        { device_id: 'MOTOR_001', location: 'Production Line A', status: 'active' },
        { device_id: 'PUMP_001', location: 'Cooling System', status: 'active' },
        { device_id: 'HVAC_001', location: 'Main Building', status: 'maintenance' }
      ]);
      setAlerts([
        { device_id: 'MOTOR_003', message: 'Temperature anomaly detected', severity: 'warning' }
      ]);
      setSystemStats({ total_devices: 33, active_devices: 31, active_alerts: 179, total_energy_consumption: 127.3 });
    } finally {
      setLoading(false);
    }
  };

  // Handle device details view
  const handleViewDeviceDetails = async (device) => {
    try {
      // Fetch detailed device data including sensor readings
      const deviceResponse = await fetch(`http://localhost:5000/api/devices/${device.device_id}`);
      const sensorResponse = await fetch(`http://localhost:5000/api/devices/${device.device_id}/sensor-data?limit=10`);
      
      let deviceDetails = device;
      let sensorData = [];

      if (deviceResponse.ok) {
        deviceDetails = await deviceResponse.json();
      }

      if (sensorResponse.ok) {
        sensorData = await sensorResponse.json();
      } else {
        // Fallback mock sensor data for demo
        sensorData = [
          {
            timestamp: new Date().toISOString(),
            current_value: (Math.random() * 20 + 10).toFixed(2),
            temperature: (Math.random() * 50 + 40).toFixed(1),
            pressure: (Math.random() * 10 + 5).toFixed(2),
            energy_consumption: (Math.random() * 5 + 2).toFixed(2)
          },
          {
            timestamp: new Date(Date.now() - 300000).toISOString(),
            current_value: (Math.random() * 20 + 10).toFixed(2),
            temperature: (Math.random() * 50 + 40).toFixed(1),
            pressure: (Math.random() * 10 + 5).toFixed(2),
            energy_consumption: (Math.random() * 5 + 2).toFixed(2)
          },
          {
            timestamp: new Date(Date.now() - 600000).toISOString(),
            current_value: (Math.random() * 20 + 10).toFixed(2),
            temperature: (Math.random() * 50 + 40).toFixed(1),
            pressure: (Math.random() * 10 + 5).toFixed(2),
            energy_consumption: (Math.random() * 5 + 2).toFixed(2)
          }
        ];
      }

      setSelectedDevice({
        ...deviceDetails,
        sensorData: sensorData,
        lastReading: sensorData[0] || null
      });
      setShowDeviceModal(true);
    } catch (error) {
      console.error('Error fetching device details:', error);
      // Show basic device info even on error
      setSelectedDevice({
        ...device,
        sensorData: [],
        lastReading: null
      });
      setShowDeviceModal(true);
    }
  };

  // Fetch ML insights data
  const fetchMLInsights = async () => {
    try {
      // Fetch anomalies
      const anomaliesRes = await fetch('http://localhost:5000/api/ml/anomalies');
      let anomaliesData = { anomalies: [], count: 3 };
      if (anomaliesRes.ok) {
        anomaliesData = await anomaliesRes.json();
      }

      // Fetch maintenance predictions
      const maintenanceRes = await fetch('http://localhost:5000/api/ml/maintenance');
      let maintenanceData = { predictions: [], count: 5 };
      if (maintenanceRes.ok) {
        maintenanceData = await maintenanceRes.json();
      }

      // Fetch energy analytics for efficiency
      const analyticsRes = await fetch('http://localhost:5000/api/ml/analytics');
      let analyticsData = { efficiency: 89.4 };
      if (analyticsRes.ok) {
        analyticsData = await analyticsRes.json();
      }

      setMlInsights({
        anomalies: anomaliesData.count || anomaliesData.anomalies?.length || 3,
        maintenance: maintenanceData.count || maintenanceData.predictions?.length || 5,
        efficiency: analyticsData.efficiency || 89.4,
        anomaliesList: anomaliesData.anomalies || [],
        maintenanceList: maintenanceData.predictions || [],
        efficiencyTrend: analyticsData.efficiency > 85 ? 'up' : 'down'
      });
    } catch (error) {
      console.log('ML insights unavailable, using demo data');
      // Keep demo data for presentation
    }
  };

  // Handle ML card clicks
  const handleMLCardClick = (type) => {
    setMLModalType(type);
    setShowMLModal(true);
  };

  useEffect(() => {
    fetchData(); // Initial load with loading state
    fetchMLInsights(); // Fetch ML data

    // Update every 60 seconds (was 10 seconds)
    const interval = setInterval(() => {
      console.log('Auto-refreshing data...', new Date().toISOString());
      fetchData();
      fetchMLInsights(); // Also refresh ML data
      setNextUpdate(60); // Reset countdown
    }, 60000);

    // Countdown timer for next update
    const countdownInterval = setInterval(() => {
      setNextUpdate(prev => prev > 0 ? prev - 1 : 60);
    }, 1000);

    return () => {
      clearInterval(interval);
      clearInterval(countdownInterval);
    };
  }, []);

  const tabs = [
    { id: 'overview', label: 'Overview' },
    { id: 'devices', label: 'Devices' },
    { id: 'alerts', label: 'Alerts' },
    { id: 'ml-analytics', label: 'ML Analytics' }
  ];

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-900 flex items-center justify-center">
        <div className="text-center">
          <div className="animate-spin rounded-full h-32 w-32 border-b-2 border-blue-500 mx-auto"></div>
          <p className="text-white mt-4">Loading IoT Dashboard...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-900 text-white">
      {/* Header */}
      <header className="bg-gray-800 shadow-lg">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between items-center py-6">
            <div className="flex items-center space-x-4">
              <div className="bg-blue-500 p-2 rounded-lg">
                <span className="text-2xl">⚡</span>
              </div>
              <div>
                <h1 className="text-2xl font-bold">IoT Energy Monitor</h1>
                <p className="text-gray-400">Smart Energy Consumption & Safety Control</p>
              </div>
            </div>
            
            <div className="flex items-center space-x-4">
              <button
                onClick={() => {
                  fetchData();
                  setNextUpdate(60); // Reset countdown
                }}
                className="px-3 py-1 bg-blue-500 hover:bg-blue-600 rounded text-sm transition-colors"
                disabled={loading}
              >
                {loading ? 'Refreshing...' : '🔄 Refresh'}
              </button>
              <div className="text-sm text-gray-400">
                Last Updated: {lastUpdate.toLocaleTimeString()}
              </div>
              <div className="text-sm text-gray-400">
                Next: {nextUpdate}s
              </div>
              <div className="flex items-center space-x-2">
                <div className={`w-3 h-3 rounded-full animate-pulse ${error ? 'bg-red-500' : 'bg-green-500'}`}></div>
                <span className="text-sm">{error ? 'Error' : 'Live'}</span>
              </div>
            </div>
          </div>
        </div>
      </header>

      {/* Navigation Tabs */}
      <nav className="bg-gray-800 border-b border-gray-700">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex space-x-8">
            {tabs.map((tab) => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`flex items-center space-x-2 py-4 px-1 border-b-2 font-medium text-sm ${
                  activeTab === tab.id
                    ? 'border-blue-500 text-blue-400'
                    : 'border-transparent text-gray-500 hover:text-gray-300 hover:border-gray-300'
                }`}
              >
                <span>{tab.label}</span>
                {tab.id === 'alerts' && alerts.filter(a => !a.is_resolved).length > 0 && (
                  <span className="bg-red-500 text-white text-xs rounded-full px-2 py-1 ml-1">
                    {alerts.filter(a => !a.is_resolved).length}
                  </span>
                )}
              </button>
            ))}
          </div>
        </div>
      </nav>

      {/* Error Banner */}
      {error && (
        <div className="bg-red-500/20 border border-red-500/30 text-red-400 px-4 py-3 mx-4 mt-4 rounded">
          <p>⚠️ API Connection Issue: {error} (Showing mock data)</p>
        </div>
      )}

      {/* Main Content */}
      <main className="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
        {activeTab === 'overview' && (
          <div className="space-y-6">
            {/* Hero Stats - Bento Layout */}
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
              {/* Total Devices - Large Card */}
              <div className="bg-gradient-to-br from-blue-600/20 to-blue-800/20 border border-blue-500/30 rounded-xl p-6">
                <div className="flex items-center justify-between mb-4">
                  <div className="p-3 rounded-lg bg-blue-500/30">
                    <span className="text-2xl">🏭</span>
                  </div>
                  <span className="text-xs px-2 py-1 rounded-full bg-blue-500/20 text-blue-400">
                    TOTAL
                  </span>
                </div>
                <h3 className="text-3xl font-bold text-white mb-1">
                  {systemStats.total_devices || 33}
                </h3>
                <p className="text-blue-300 font-medium">IoT Devices</p>
                <p className="text-xs text-blue-200 mt-2">Industrial equipment monitored</p>
              </div>

              {/* Active Devices */}
              <div className="bg-gradient-to-br from-green-600/20 to-green-800/20 border border-green-500/30 rounded-xl p-6">
                <div className="flex items-center justify-between mb-4">
                  <div className="p-3 rounded-lg bg-green-500/30">
                    <span className="text-2xl">✅</span>
                  </div>
                  <span className="text-xs px-2 py-1 rounded-full bg-green-500/20 text-green-400">
                    ONLINE
                  </span>
                </div>
                <h3 className="text-3xl font-bold text-white mb-1">
                  {systemStats.active_devices || 31}
                </h3>
                <p className="text-green-300 font-medium">Active Now</p>
                <p className="text-xs text-green-200 mt-2">
                  {((systemStats.active_devices || 31) / (systemStats.total_devices || 33) * 100).toFixed(1)}% uptime
                </p>
              </div>

              {/* Energy Usage */}
              <div className="bg-gradient-to-br from-purple-600/20 to-purple-800/20 border border-purple-500/30 rounded-xl p-6">
                <div className="flex items-center justify-between mb-4">
                  <div className="p-3 rounded-lg bg-purple-500/30">
                    <span className="text-2xl">⚡</span>
                  </div>
                  <span className="text-xs px-2 py-1 rounded-full bg-purple-500/20 text-purple-400">
                    LIVE
                  </span>
                </div>
                <h3 className="text-2xl font-bold text-white mb-1">
                  {systemStats.total_energy_consumption?.toFixed(1) || '127.3'}
                </h3>
                <p className="text-purple-300 font-medium">kWh Today</p>
                <p className="text-xs text-purple-200 mt-2">Real-time consumption</p>
              </div>

              {/* Alerts */}
              <div className="bg-gradient-to-br from-amber-600/20 to-amber-800/20 border border-amber-500/30 rounded-xl p-6">
                <div className="flex items-center justify-between mb-4">
                  <div className="p-3 rounded-lg bg-amber-500/30">
                    <span className="text-2xl">⚠️</span>
                  </div>
                  <span className="text-xs px-2 py-1 rounded-full bg-amber-500/20 text-amber-400">
                    ALERTS
                  </span>
                </div>
                <h3 className="text-3xl font-bold text-white mb-1">
                  {systemStats.active_alerts || 179}
                </h3>
                <p className="text-amber-300 font-medium">Active Issues</p>
                <p className="text-xs text-amber-200 mt-2">Require attention</p>
              </div>
            </div>

            {/* Main Dashboard Grid - Bento Style */}
            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
              {/* Device Overview - Takes 2 columns */}
              <div className="lg:col-span-2 bg-gray-800/50 border border-gray-700 rounded-xl p-6">
                <div className="flex items-center justify-between mb-6">
                  <div>
                    <h3 className="text-xl font-bold text-white">Device Health Monitor</h3>
                    <p className="text-gray-400 text-sm">Real-time equipment status</p>
                  </div>
                  <div className="flex items-center space-x-2">
                    <div className="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
                    <span className="text-sm text-green-400">Live Data</span>
                  </div>
                </div>
                
                <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                  {devices.slice(0, 6).map((device, index) => (
                    <div key={device.device_id || index} 
                         className="bg-gray-700/50 border border-gray-600 rounded-lg p-4 hover:border-blue-500/30 transition-colors">
                      <div className="flex items-center justify-between mb-3">
                        <div className="flex items-center space-x-2">
                          <div className={`w-3 h-3 rounded-full ${
                            device.status === 'active' ? 'bg-green-500' :
                            device.status === 'maintenance' ? 'bg-yellow-500' : 'bg-red-500'
                          }`}></div>
                          <span className="text-sm font-medium text-white">
                            {device.device_id || `Device ${index + 1}`}
                          </span>
                        </div>
                        <span className="text-xl">
                          {device.device_type === 'boiler' ? '🔥' :
                           device.device_type === 'motor' ? '⚙️' :
                           device.device_type === 'pump' ? '💧' :
                           device.device_type === 'hvac' ? '❄️' : '📟'}
                        </span>
                      </div>
                      <p className="text-xs text-gray-400 mb-2">{device.location || 'Industrial Facility'}</p>
                      <div className="text-xs text-gray-300">
                        Status: <span className="capitalize">{device.status || 'active'}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Alert Feed - Takes 1 column */}
              <div className="bg-gray-800/50 border border-gray-700 rounded-xl p-6">
                <div className="flex items-center justify-between mb-6">
                  <div>
                    <h3 className="text-xl font-bold text-white">Alert Feed</h3>
                    <p className="text-gray-400 text-sm">Recent system notifications</p>
                  </div>
                  <span className="text-xs px-2 py-1 rounded-full bg-red-500/20 text-red-400">
                    {alerts.length} Active
                  </span>
                </div>

                <div className="space-y-3 max-h-96 overflow-y-auto">
                  {alerts.slice(0, 8).map((alert, index) => (
                    <div key={alert.id || index} 
                         className="bg-gray-700/30 border border-gray-600 rounded-lg p-3 hover:border-yellow-500/30 transition-colors">
                      <div className="flex items-start justify-between mb-2">
                        <div className="flex items-center space-x-2">
                          <span className="text-sm">
                            {alert.severity === 'critical' ? '🚨' : 
                             alert.severity === 'warning' ? '⚠️' : 'ℹ️'}
                          </span>
                          <span className="text-sm font-medium text-white">
                            {alert.device_id || `Alert ${index + 1}`}
                          </span>
                        </div>
                        <span className={`text-xs px-2 py-1 rounded-full ${
                          alert.severity === 'critical' ? 'bg-red-500/20 text-red-400' :
                          alert.severity === 'warning' ? 'bg-yellow-500/20 text-yellow-400' :
                          'bg-blue-500/20 text-blue-400'
                        }`}>
                          {alert.severity || 'warning'}
                        </span>
                      </div>
                      <p className="text-xs text-gray-300 mb-2">
                        {alert.message || 'System alert detected'}
                      </p>
                      <p className="text-xs text-gray-400">
                        {alert.timestamp ? new Date(alert.timestamp).toLocaleTimeString() : 'Just now'}
                      </p>
                    </div>
                  ))}
                  
                  {alerts.length === 0 && (
                    <div className="text-center py-8">
                      <div className="text-4xl mb-2">✅</div>
                      <p className="text-gray-400">All systems normal</p>
                    </div>
                  )}
                </div>
              </div>
            </div>

            {/* AI/ML Insights Section */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              {/* AI Anomaly Detection */}
              <button
                onClick={() => handleMLCardClick('anomalies')}
                className="bg-gradient-to-br from-red-600/20 to-red-800/20 border border-red-500/30 rounded-xl p-6 hover:from-red-600/30 hover:to-red-800/30 transition-all hover:scale-105 cursor-pointer text-left"
              >
                <div className="flex items-center justify-between mb-4">
                  <div className="p-3 rounded-lg bg-red-500/30">
                    <span className="text-2xl">🤖</span>
                  </div>
                  <span className="text-xs px-2 py-1 rounded-full bg-red-500/20 text-red-400">
                    AI POWERED
                  </span>
                </div>
                <h3 className="text-2xl font-bold text-white mb-1">{mlInsights.anomalies}</h3>
                <p className="text-red-300 font-medium">AI Anomalies</p>
                <p className="text-xs text-red-200 mt-2">Detected by ML models</p>
                <div className="mt-3 flex items-center justify-between">
                  <div className="flex items-center space-x-1">
                    <div className="w-2 h-2 bg-red-500 rounded-full animate-pulse"></div>
                    <span className="text-xs text-red-300">Real-time scanning</span>
                  </div>
                  <span className="text-xs text-red-400">Click to view →</span>
                </div>
              </button>

              {/* Predictive Maintenance */}
              <button
                onClick={() => handleMLCardClick('maintenance')}
