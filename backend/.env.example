# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here
PORT=5001

# Database
DATABASE_URL=iot_data.db

# Email Configuration (for Gmail)
# 1. Enable 2-Factor Authentication in your Gmail account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the App Password (not your Gmail password) below

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password-here
RECIPIENT_EMAIL=arfatnaik800@gmail.com

# Note: For Gmail, you MUST use an App Password, not your regular password
# Steps to get App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select "Mail" and "Other (Custom name)" 
# 5. Generate password and use it as SENDER_PASSWORD
