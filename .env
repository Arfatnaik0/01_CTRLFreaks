# Environment Configuration
DATABASE_URL=postgresql://iot_user:iot_password@localhost:5432/iot_energy_db
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true

# Kafka Topics
SENSOR_DATA_TOPIC=sensor-data
ALERTS_TOPIC=alerts
CONTROL_COMMANDS_TOPIC=control-commands

# ML Configuration
MODEL_UPDATE_INTERVAL=3600  # seconds
PREDICTION_WINDOW=24  # hours

# Alert Thresholds
CRITICAL_TEMPERATURE_THRESHOLD=90
CRITICAL_CURRENT_THRESHOLD=0.95
CRITICAL_PRESSURE_THRESHOLD=0.9